# Renombrar a .env y completar con tus valores

# Firebase Admin SDK - descargar JSON desde Firebase Console > Project Settings > Service accounts
FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json

# Ollama - URL del servidor local
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3

# Whisper - modelo a usar (tiny, base, small, medium, large)
WHISPER_MODEL=base

# CORS - origen del frontend Angular en desarrollo
FRONTEND_URL=http://localhost:4200

# Resend - servicio de email (https://resend.com, free tier: 3000 emails/mes)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Remitente verificado (en sandbox de Resend usá onboarding@resend.dev)
EMAIL_FROM=SecretarIA <onboarding@resend.dev>

# ── Control de uso de IA (Groq) ──────────────────────────────
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Cupo por plan (minutos de audio). Vacío = uso libre para ese plan.
AI_QUOTA_PLAN1_AUDIO_MIN_MONTH=1950
AI_QUOTA_PLAN1_AUDIO_MIN_DAY=90
AI_QUOTA_PLAN2_AUDIO_MIN_MONTH=
AI_QUOTA_PLAN2_AUDIO_MIN_DAY=
AI_QUOTA_PLAN3_AUDIO_MIN_MONTH=
AI_QUOTA_PLAN3_AUDIO_MIN_DAY=
AI_QUOTA_WARN_PCT=80

# Límites de la cuenta Groq (plan gratuito, ver console.groq.com/settings/limits)
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_LIMIT_WHISPER_RPM=20
GROQ_LIMIT_WHISPER_RPD=2000
GROQ_LIMIT_WHISPER_ASH=7200
GROQ_LIMIT_WHISPER_ASD=28800
GROQ_LIMIT_LLM_RPM=30
GROQ_LIMIT_LLM_RPD=1000
GROQ_LIMIT_LLM_TPM=8000
GROQ_LIMIT_LLM_TPD=200000
GROQ_ACCOUNT_MARGIN_PCT=90

# Reintentos ante 429 de Groq
GROQ_RETRY_MAX_ATTEMPTS=3
GROQ_RETRY_BASE_SECONDS=2
GROQ_RETRY_MAX_WAIT_SECONDS=20

# Mail que recibe alertas de uso (vacío = solo log)
AI_ALERT_EMAIL=
